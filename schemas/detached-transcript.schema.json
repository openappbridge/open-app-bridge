{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oab:schema:detached-transcript:1.0",
  "title": "Open App Bridge detached-datachannel/1 cryptographic transcript",
  "description": "The exact canonical transcript bound into ECDH/HKDF answer encryption and transcript verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "wireVersion",
    "transport",
    "transportVersion",
    "requestId",
    "channelId",
    "senderOrigin",
    "receiverOrigin",
    "receiverHelper",
    "senderPublicKey",
    "callbackPath",
    "createdAt",
    "expiresAt",
    "declarationId",
    "offerDigest"
  ],
  "properties": {
    "protocol": { "const": "org.openapp.bridge" },
    "wireVersion": { "const": "1.0" },
    "transport": { "const": "detached-datachannel/1" },
    "transportVersion": { "const": "1" },
    "requestId": { "$ref": "urn:oab:schema:detached-offer:1.0#/$defs/token" },
    "channelId": { "$ref": "urn:oab:schema:detached-offer:1.0#/$defs/channelCapability" },
    "senderOrigin": { "$ref": "urn:oab:schema:detached-offer:1.0#/$defs/origin" },
    "receiverOrigin": { "$ref": "urn:oab:schema:detached-offer:1.0#/$defs/origin" },
    "receiverHelper": { "$ref": "urn:oab:schema:detached-offer:1.0#/properties/receiverHelper" },
    "senderPublicKey": { "$ref": "urn:oab:schema:detached-offer:1.0#/$defs/publicKey" },
    "callbackPath": { "const": "/.well-known/open-app-bridge/callback" },
    "createdAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "expiresAt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "declarationId": {
      "type": ["string", "null"],
      "minLength": 8,
      "maxLength": 512,
      "pattern": "^[!-~]+$"
    },
    "offerDigest": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    }
  }
}
