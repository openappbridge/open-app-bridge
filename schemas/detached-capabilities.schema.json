{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oab:schema:detached-capabilities:1.0",
  "title": "Open App Bridge detached-datachannel/1 live receiver capabilities",
  "description": "Structural schema. Conforming implementations also require maximumFrameBytes <= maximumTransferBytes, maximumTransferBytes to be frameable within the global 65536-data-frame transfer ceiling, and the canonical serialized control to fit maximumFrameBytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "representations",
    "assetTypes",
    "maximumTransferBytes",
    "maximumAssets",
    "maximumFrameBytes"
  ],
  "properties": {
    "representations": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/mime" }
    },
    "assetTypes": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/mime" }
    },
    "maximumTransferBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 33554432
    },
    "maximumAssets": { "type": "integer", "minimum": 0, "maximum": 256 },
    "maximumFrameBytes": {
      "type": "integer",
      "minimum": 17,
      "maximum": 16384
    }
  },
  "allOf": [
    {
      "anyOf": [
        { "properties": { "representations": { "minItems": 1 } } },
        { "properties": { "assetTypes": { "minItems": 1 } } }
      ]
    },
    {
      "if": {
        "properties": { "maximumAssets": { "const": 0 } },
        "required": ["maximumAssets"]
      },
      "then": { "properties": { "assetTypes": { "maxItems": 0 } } },
      "else": { "properties": { "assetTypes": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "mime": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
    }
  }
}
