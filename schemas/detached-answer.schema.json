{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oab:schema:detached-answer:1.0",
  "title": "Open App Bridge detached-datachannel/1 semantic answer",
  "description": "The semantic receiver answer nested in the encrypted sealed plaintext. This structural schema does not replace the normative browser-assisted SDP and ICE validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "candidates"],
  "properties": {
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sdp"],
      "properties": {
        "type": { "const": "answer" },
        "sdp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^[\\u0009\\u000A\\u000D\\u0020-\\u007E]+$"
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "urn:oab:schema:detached-offer:1.0#/$defs/candidate" }
    }
  }
}
