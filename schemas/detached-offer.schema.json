{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oab:schema:detached-offer:1.0",
  "title": "Open App Bridge detached-datachannel/1 signaling offer",
  "description": "A content-free, fragment-carried WebRTC data-channel bootstrap. The encoded fragment is additionally capped at 32768 bytes and by the receiver's lower maximumSignalingBytes. This structural schema does not replace the normative semantic validator for canonical JSON, time relationships, browser-generated data-only SDP, or browser-parsed mDNS host ICE candidates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "wireVersion",
    "transport",
    "transportVersion",
    "requestId",
    "channelId",
    "createdAt",
    "expiresAt",
    "senderOrigin",
    "receiverOrigin",
    "receiverHelper",
    "declarationId",
    "senderPublicKey",
    "description",
    "candidates"
  ],
  "properties": {
    "protocol": { "const": "org.openapp.bridge" },
    "wireVersion": { "const": "1.0" },
    "transport": { "const": "detached-datachannel/1" },
    "transportVersion": { "const": "1" },
    "requestId": { "$ref": "#/$defs/token" },
    "channelId": { "$ref": "#/$defs/channelCapability" },
    "createdAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "expiresAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Must be after createdAt and no more than 300000 milliseconds later."
    },
    "senderOrigin": { "$ref": "#/$defs/origin" },
    "receiverOrigin": { "$ref": "#/$defs/origin" },
    "receiverHelper": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^(?:https://(?![^/?#]*@)[^/?#]+|http://(?:localhost|(?:[A-Za-z0-9-]+\\.)*localhost|127(?:\\.(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})){3}|\\[::1\\])(?::[0-9]{1,5})?)/(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^%?#\\\\\\u0000-\\u001F\\u007F]*$",
      "description": "The exact discovered receiver-origin helper URL, without query or fragment."
    },
    "declarationId": {
      "type": ["string", "null"],
      "minLength": 8,
      "maxLength": 512,
      "pattern": "^[!-~]+$"
    },
    "senderPublicKey": { "$ref": "#/$defs/publicKey" },
    "description": { "$ref": "#/$defs/offerDescription" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "anyOf": [
        { "pattern": "^(?:[A-Za-z0-9_-]{4}){6,32}$" },
        { "pattern": "^(?:[A-Za-z0-9_-]{4}){5,31}[A-Za-z0-9_-][AQgw]$" },
        { "pattern": "^(?:[A-Za-z0-9_-]{4}){5,31}[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048]$" }
      ]
    },
    "channelCapability": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "origin": {
      "type": "string",
      "format": "uri",
      "pattern": "^(?:https://(?![^/?#]*@)[^/?#]+|http://(?:localhost|(?:[A-Za-z0-9-]+\\.)*localhost|127(?:\\.(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})){3}|\\[::1\\])(?::[0-9]{1,5})?)$"
    },
    "publicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kty", "crv", "x", "y"],
      "properties": {
        "kty": { "const": "EC" },
        "crv": { "const": "P-256" },
        "x": { "type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$" },
        "y": { "type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$" }
      }
    },
    "offerDescription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sdp"],
      "properties": {
        "type": { "const": "offer" },
        "sdp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^[\\u0009\\u000A\\u000D\\u0020-\\u007E]+$",
          "description": "Structural ASCII bound only. The normative validator requires one application m-line, exact ICE/DTLS/SCTP critical attributes, no media and no embedded candidate lines."
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "sdpMid",
        "sdpMLineIndex",
        "usernameFragment"
      ],
      "properties": {
        "candidate": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^candidate:[A-Za-z0-9+/]+ 1 (?:udp|tcp) [0-9]{1,10} [A-Za-z0-9.-]+\\.local [0-9]{1,5} typ host(?: [\\x21-\\x7E]+)*$",
          "description": "Structural bound only. The normative validator additionally enforces a canonical mDNS hostname, uint32 priority, legal port/protocol/tcptype, no related address or port, exact data m-line binding, and browser parser agreement."
        },
        "sdpMid": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[!-~]+$" },
        "sdpMLineIndex": { "const": 0 },
        "usernameFragment": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9+/]{4,256}$"
        }
      }
    }
  }
}
