{
  "hosting": {
    "rewrites": [
      {
        "source": "/.well-known/open-app-bridge",
        "destination": "/open-app-bridge.json"
      },
      {
        "source": "/_oab/detached-helper",
        "destination": "/detached-helper.html"
      },
      {
        "source": "/.well-known/open-app-bridge/callback",
        "destination": "/oab-callback.html"
      },
      {
        "source": "/_oab/receive",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/open-app-bridge",
        "headers": [
          { "key": "Access-Control-Allow-Origin", "value": "*" },
          { "key": "Cache-Control", "value": "public, max-age=300" },
          { "key": "Content-Type", "value": "application/json; charset=utf-8" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          { "key": "Access-Control-Allow-Origin", "value": "*" },
          { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
        ]
      },
      {
        "source": "/app-icon.png",
        "headers": [
          { "key": "Access-Control-Allow-Origin", "value": "*" },
          { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "/_oab/detached-helper",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
          { "key": "Referrer-Policy", "value": "origin" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" }
        ]
      },
      {
        "source": "/_oab/receive",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-yWjp6X7L9yDoL9kNnbJwPcOSFZc7Jycj8BFWlRpxWV0='; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" }
        ]
      },
      {
        "source": "/.well-known/open-app-bridge/callback",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" }
        ]
      },
      {
        "source": "/_oab/resources/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      }
    ]
  }
}
